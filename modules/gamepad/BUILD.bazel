load("@rules_android//rules:rules.bzl", "android_library")
load("//bazel/rules:mel_codegen.bzl", "mel_codegen")

package(default_visibility = ["//visibility:public"])

DEPS = ["//modules/core", "//modules/allocator", "//modules/collection", "//modules/string", "//modules/event", "//modules/executor", "//modules/log", "//modules/reflect", "//modules/guid", "//modules/platform", "//modules/thread", "//modules/debug"]

INCLUDES = ["include", "macos/include", "ios/include", "linux/include", "android/include", "win32/include", "wasm/include"]

mel_codegen(
    name = "protocol_enum_gen",
    out = "gamepad.protocol.enum.gen.c",
    tool = "//modules/reflect:enum-str-gen",
    args = ["$out", "$cflags", "$hostclang", "--", "gamepad/protocol.h"],
    srcs = ["include/gamepad/protocol.h"],
    deps = DEPS,
    local_includes = ["modules/gamepad/include", "modules/gamepad/macos/include", "modules/gamepad/ios/include", "modules/gamepad/linux/include", "modules/gamepad/android/include", "modules/gamepad/win32/include", "modules/gamepad/wasm/include"],
)

mel_codegen(
    name = "gamepad_enum_gen",
    out = "gamepad.gamepad.enum.gen.c",
    tool = "//modules/reflect:enum-str-gen",
    args = ["$out", "$cflags", "$hostclang", "--", "gamepad/gamepad.h"],
    srcs = ["include/gamepad/gamepad.h"],
    deps = DEPS,
    local_includes = ["modules/gamepad/include", "modules/gamepad/macos/include", "modules/gamepad/ios/include", "modules/gamepad/linux/include", "modules/gamepad/android/include", "modules/gamepad/win32/include", "modules/gamepad/wasm/include"],
)

cc_library(
    name = "gamepad",
    srcs = glob(["src/*.c", "src/*.h"]) + [":protocol_enum_gen", ":gamepad_enum_gen"] + select({
        "//bazel/config:plat_linux": glob(["linux/src/*.c", "linux/src/*.h"], allow_empty = True),
        "//bazel/config:plat_android": glob(["android/src/*.c", "android/src/*.h"], allow_empty = True),
        "//bazel/config:plat_win32": glob(["win32/src/*.c", "win32/src/*.h"], allow_empty = True),
        "//bazel/config:plat_wasm": glob(["wasm/src/*.c"]),
        "//conditions:default": [],
    }),
    hdrs = glob(["include/**/*.h", "*/include/**/*.h"]),
    includes = INCLUDES,
    linkopts = select({
        "//bazel/config:plat_macos": ["-framework", "GameController", "-framework", "IOKit", "-framework", "Foundation"],
        "//bazel/config:plat_ios": ["-framework", "GameController", "-framework", "Foundation"],
        "//bazel/config:plat_win32": ["-lxinput"],
        "//conditions:default": [],
    }),
    deps = DEPS + select({
        "//bazel/config:plat_macos": [":gamepad_apple"],
        "//bazel/config:plat_ios": [":gamepad_apple"],
        "//conditions:default": [],
    }),
)

android_library(
    name = "android_java",
    srcs = glob(["android/java/**/*.java"]),
    custom_package = "orgwall.melody.gamepad",
    target_compatible_with = select({
        "//bazel/config:plat_android": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

objc_library(
    name = "gamepad_apple",
    srcs = glob(["src/*.h", "include/**/*.h", "*/include/**/*.h"]) + select({
        "//bazel/config:plat_macos": glob(["macos/src/*.m"]),
        "//bazel/config:plat_ios": glob(["ios/src/*.m"]),
        "//conditions:default": [],
    }),
    includes = INCLUDES,
    deps = DEPS,
    target_compatible_with = select({
        "//bazel/config:plat_macos": [],
        "//bazel/config:plat_ios": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

cc_test(
    name = "gamepad-core",
    srcs = ["test/gamepad_test.c"],
    deps = ["//tools/test:runner", "//modules/test", ":gamepad", "//modules/guid"],
)
