package(default_visibility = ["//visibility:public"])

cc_library(
    name = "execution",
    srcs = ["src/execution.cc"],
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
    target_compatible_with = select({
        "//bazel/config:plat_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//modules/core",
        "//modules/allocator",
        "@stdexec//:stdexec",
    ],
)

cc_test(
    name = "execution-test",
    srcs = ["test/test_execution.c"],
    target_compatible_with = select({
        "//bazel/config:plat_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//tools/test:runner",
        "//modules/test",
        ":execution",
    ],
)
