load("//bazel/rules:mel_codegen.bzl", "mel_codegen")

package(default_visibility = ["//visibility:public"])

DEPS = [
    "//modules/core",
    "//modules/math",
    "//modules/frequency",
    "//modules/musictuning",
    "//modules/allocator",
    "//modules/collection",
    "//modules/coro",
]

mel_codegen(
    name = "scale_gen",
    out = "scale_gen.gen.c",
    tool = "//modules/coro:coro-gen",
    args = ["$dir/include/musictheory/scale_gen.coro.h", "$out", "-DMEL_CORO_CODEGEN", "$cflags", "$hostclang"],
    srcs = ["include/musictheory/scale_gen.coro.h"],
    deps = DEPS,
    local_includes = ["modules/musictheory/include", "modules/musictheory/include/musictheory"],
)

cc_library(
    name = "musictheory",
    srcs = glob(["src/*.c"]) + [":scale_gen"],
    hdrs = glob(["include/**/*.h"]),
    includes = ["include", "include/musictheory"],
    deps = DEPS,
)

cc_test(
    name = "musictheory-test",
    srcs = ["test/test_musictheory.c"],
    deps = [
        "//tools/test:runner",
        "//modules/test",
        ":musictheory",
    ],
)
