package(default_visibility = ["//visibility:public"])

DEPS = [
    "//modules/core",
    "//modules/platform",
    "//modules/temperature",
    "//modules/allocator",
]

cc_library(
    name = "thermal",
    srcs = glob(["src/*.c", "src/*.h"]) + select({
        "//bazel/config:plat_macos": glob(["macos/src/*.c", "apple/src/*.c"]),
        "//bazel/config:plat_ios": glob(["ios/src/*.c", "apple/src/*.c"]),
        "//bazel/config:plat_linux": glob(["linux/src/*.c", "linux/src/*.h"], allow_empty = True),
        "//bazel/config:plat_win32": glob(["win32/src/*.c", "win32/src/*.h"], allow_empty = True),
        "//bazel/config:plat_android": glob(["android/src/*.c", "android/src/*.h"], allow_empty = True),
        "//bazel/config:plat_wasm": glob(["web/src/*.c", "web/src/*.h"], allow_empty = True),
        "//conditions:default": [],
    }),
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
    linkopts = select({
        "//bazel/config:plat_macos": ["-framework", "Foundation", "-framework", "IOKit"],
        "//bazel/config:plat_ios": ["-framework", "Foundation"],
        "//conditions:default": [],
    }),
    deps = DEPS + select({
        "//bazel/config:plat_macos": [":thermal_apple"],
        "//bazel/config:plat_ios": [":thermal_apple"],
        "//conditions:default": [],
    }),
)

objc_library(
    name = "thermal_apple",
    srcs = glob(["apple/src/*.m", "apple/src/*.h", "src/*.h", "include/**/*.h"], allow_empty = True),
    includes = ["include"],
    deps = DEPS,
    target_compatible_with = select({
        "//bazel/config:plat_macos": [],
        "//bazel/config:plat_ios": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

cc_binary(
    name = "thermal-sensors",
    srcs = ["example/thermal_sensors.c"],
    deps = [
        "//modules/thermal",
        "//modules/temperature",
        "//modules/allocator",
        "//modules/core",
    ],
)
