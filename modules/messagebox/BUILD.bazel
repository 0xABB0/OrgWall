load("@rules_android//rules:rules.bzl", "android_library")

package(default_visibility = ["//visibility:public"])

DEPS = [
    "//modules/core",
    "//modules/string",
    "//modules/color",
    "//modules/window",
    "//modules/allocator",
    "//modules/log",
]

cc_library(
    name = "messagebox",
    srcs = glob(["src/*.c"]) + select({
        "//bazel/config:plat_win32": glob(["win32/src/*.c", "win32/src/*.h"], allow_empty = True),
        "//bazel/config:plat_linux": glob(["linux/src/*.c", "linux/src/*.h"], allow_empty = True),
        "//bazel/config:plat_android": glob(["android/src/*.c", "android/src/*.h"], allow_empty = True),
        "//bazel/config:plat_wasm": glob(["web/src/*.c", "web/src/*.h"], allow_empty = True),
        "//conditions:default": [],
    }),
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
    linkopts = select({
        "//bazel/config:plat_macos": ["-framework", "AppKit", "-framework", "Foundation"],
        "//bazel/config:plat_ios": ["-framework", "UIKit", "-framework", "Foundation"],
        "//bazel/config:plat_win32": ["-lcomctl32"],
        "//bazel/config:plat_linux": ["-ldl"],
        "//conditions:default": [],
    }),
    deps = DEPS + select({
        "//bazel/config:plat_android": ["//modules/platform"],
        "//conditions:default": [],
    }) + select({
        "//bazel/config:plat_macos": [":messagebox_apple"],
        "//bazel/config:plat_ios": [":messagebox_apple"],
        "//conditions:default": [],
    }),
)

android_library(
    name = "android_java",
    srcs = glob(["android/java/**/*.java"]),
    custom_package = "orgwall.melody.messagebox",
    target_compatible_with = select({
        "//bazel/config:plat_android": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

objc_library(
    name = "messagebox_apple",
    srcs = glob(["apple/src/*.m", "include/**/*.h"]),
    includes = ["include"],
    deps = DEPS,
    target_compatible_with = select({
        "//bazel/config:plat_macos": [],
        "//bazel/config:plat_ios": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

cc_test(
    name = "messagebox-core",
    srcs = [
        "src/messagebox.c",
        "test/test_messagebox.c",
    ] + glob(["include/**/*.h"]),
    includes = ["include"],
    deps = [
        "//tools/test:runner",
        "//modules/test",
        "//modules/core",
        "//modules/string",
        "//modules/color",
        "//modules/window",
        "//modules/allocator",
        "//modules/log",
    ],
)
