        "//tools/test:runner",
        "//modules/test",
        ":time",
        "//modules/core",
    ],
)

cc_test(
    name = "time-clock",
    srcs = ["test/test.clock.c"],
    deps = [
        "//tools/test:runner",
        "//modules/test",
        ":time",
        "//modules/core",
        "//modules/string",
        "//modules/allocator",
    ],
)

cc_test(
    name = "time-sleep",
    srcs = ["test/test.sleep.c"],
    deps = [
        "//tools/test:runner",
        "//modules/test",
        ":time",
        "//modules/core",
    ],
)

cc_test(
    name = "time-format-prefs",
    srcs = ["test/test.format_prefs.c"],
    deps = [
        "//tools/test:runner",
