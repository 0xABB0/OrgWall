package(default_visibility = ["//visibility:public"])

DEPS = [
    "//modules/core",
    "//modules/allocator",
    "//modules/collection",
    "//modules/string",
    "//modules/event",
    "//modules/executor",
    "//modules/log",
]

cc_library(
    name = "tray",
    srcs = ["src/tray.c", "src/menu.c"] + glob(["src/*.h"]) + select({
        "//bazel/config:plat_win32": glob(["win32/src/*.c", "win32/src/*.h"], allow_empty = True),
        "//bazel/config:plat_linux": glob(["linux/src/*.c", "linux/src/*.h"], allow_empty = True),
        "//bazel/config:plat_ios": ["src/tray_host_none.c"],
        "//bazel/config:plat_android": ["src/tray_host_none.c"],
        "//bazel/config:plat_wasm": ["src/tray_host_none.c"],
        "//conditions:default": [],
    }),
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"] + select({
        "//bazel/config:plat_macos": ["macos/include"],
        "//bazel/config:plat_win32": ["win32/include"],
        "//bazel/config:plat_linux": ["linux/include"],
        "//conditions:default": [],
    }),
    linkopts = select({
        "//bazel/config:plat_macos": ["-framework", "AppKit", "-framework", "Foundation"],
        "//bazel/config:plat_win32": ["-lshell32", "-luser32", "-lgdi32"],
        "//bazel/config:plat_linux": ["-ldl"],
        "//conditions:default": [],
    }),
    deps = DEPS + select({
        "//bazel/config:plat_macos": [":tray_macos"],
        "//conditions:default": [],
    }),
)

objc_library(
    name = "tray_macos",
    srcs = glob([
        "macos/src/*.m",
        "macos/include/**/*.h",
        "src/*.h",
        "include/**/*.h",
    ]),
    copts = ["-fobjc-arc"],
    includes = ["include", "macos/include"],
    deps = DEPS,
    target_compatible_with = select({
        "//bazel/config:plat_macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

cc_test(
    name = "tray-core",
    srcs = ["test/tray_test.c"],
    deps = [
        "//tools/test:runner",
        "//modules/test",
        ":tray",
    ],
)
