load("//bazel/rules:mel_codegen.bzl", "mel_codegen")

package(default_visibility = ["//visibility:public"])

FIXTURES = ["sum_to", "countdown", "classify", "relay", "repeat_sum"]

cc_library(
    name = "coro",
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
    deps = ["//modules/core"],
)

cc_binary(
    name = "coro-gen",
    srcs = ["codegen/coro_gen.c"],
    deps = ["@llvm//:libclang"],
)

mel_codegen(
    name = "ticker_gen",
    out = "ticker.gen.c",
    tool = ":coro-gen",
    args = ["$dir/example/ticker.coro.h", "$out", "-DMEL_CORO_CODEGEN", "$cflags", "$hostclang"],
    srcs = ["example/ticker.coro.h"],
    deps = [":coro", "//modules/core"],
    local_includes = ["modules/coro/example"],
)

cc_binary(
    name = "coro-example",
    srcs = ["example/app.c", ":ticker_gen"] + glob(["example/*.h"]),
    includes = ["example"],
    deps = [":coro", "//modules/core"],
)

[
    mel_codegen(
        name = f + "_gen",
        out = f + ".gen.c",
        tool = ":coro-gen",
        args = ["$dir/test/fixtures/" + f + ".coro.h", "$out", "-DMEL_CORO_CODEGEN", "$cflags", "$hostclang"],
        srcs = ["test/fixtures/" + f + ".coro.h"],
        deps = [":coro", "//modules/core"],
        local_includes = ["modules/coro/test/driver", "modules/coro/test/fixtures", "modules/coro/include"],
    )
    for f in FIXTURES
]

[
    cc_test(
        name = "coro-test-" + f,
        srcs = ["test/driver/" + f + "_diff.c", ":" + f + "_gen"] + glob(["test/fixtures/*.h", "test/driver/*.h"]),
        includes = ["test/driver", "test/fixtures", "include"],
        deps = [":coro", "//modules/core"],
    )
    for f in FIXTURES
]

mel_codegen(
    name = "sum_to_snap_gen",
    out = "sum_to_snap.gen.c",
    tool = ":coro-gen",
    args = ["$dir/test/fixtures/sum_to.coro.h", "$out", "-DMEL_CORO_CODEGEN", "$cflags", "$hostclang"],
    srcs = ["test/fixtures/sum_to.coro.h"],
    deps = [":coro", "//modules/core"],
    local_includes = ["modules/coro/test/driver", "modules/coro/test/fixtures", "modules/coro/include"],
)

cc_test(
    name = "coro-test-snapshot",
    srcs = ["test/driver/snapshot.c", ":sum_to_snap_gen"] + glob(["test/fixtures/*.h", "test/driver/*.h"]),
    includes = ["test/driver", "test/fixtures", "include"],
    deps = [":coro", "//modules/core"],
)
