load("@rules_android//rules:rules.bzl", "android_library")

package(default_visibility = ["//visibility:public"])

DEPS = [
    "//modules/core",
    "//modules/allocator",
    "//modules/collection",
    "//modules/string",
    "//modules/event",
    "//modules/executor",
    "//modules/future",
    "//modules/log",
]

cc_library(
    name = "notification",
    srcs = ["src/notification.c"] + glob(["src/*.h"]) + select({
        "//bazel/config:plat_linux": glob(["linux/src/*.c", "linux/src/*.h"], allow_empty = True),
        "//bazel/config:plat_wasm": glob(["web/src/*.c", "web/src/*.h"], allow_empty = True),
        "//bazel/config:plat_android": glob(["android/src/*.c", "android/src/*.h"], allow_empty = True),
        "//bazel/config:plat_win32": ["src/notification_host_none.c"],
        "//conditions:default": [],
    }),
    hdrs = glob(["include/**/*.h"]) + select({
        "//bazel/config:plat_linux": glob(["linux/include/**/*.h"]),
        "//conditions:default": [],
    }),
    includes = ["include"] + select({
        "//bazel/config:plat_linux": ["linux/include"],
        "//conditions:default": [],
    }),
    linkopts = select({
        "//bazel/config:plat_macos": ["-framework", "Foundation", "-framework", "UserNotifications", "-framework", "AppKit"],
        "//bazel/config:plat_ios": ["-framework", "Foundation", "-framework", "UserNotifications", "-framework", "UIKit"],
        "//bazel/config:plat_linux": ["-ldbus-1", "-ldl"],
        "//conditions:default": [],
    }),
    deps = DEPS + select({
        "//bazel/config:plat_android": ["//modules/platform"],
        "//conditions:default": [],
    }) + select({
        "//bazel/config:plat_macos": [":notification_apple"],
        "//bazel/config:plat_ios": [":notification_apple"],
        "//conditions:default": [],
    }),
)

android_library(
    name = "android_java",
    srcs = glob(["android/java/**/*.java"]),
    custom_package = "orgwall.melody.notification",
    exports_manifest = True,
    manifest = "android/AndroidManifest.xml",
    target_compatible_with = select({
        "//bazel/config:plat_android": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

objc_library(
    name = "notification_apple",
    srcs = glob(["apple/src/*.m", "src/*.h", "include/**/*.h"]),
    includes = ["include"],
    copts = ["-fobjc-arc"],
    deps = DEPS,
    target_compatible_with = select({
        "//bazel/config:plat_macos": [],
        "//bazel/config:plat_ios": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

cc_test(
    name = "notification-core",
    srcs = ["test/notification_test.c"],
    deps = [
        "//tools/test:runner",
        "//modules/test",
        ":notification",
    ],
)
