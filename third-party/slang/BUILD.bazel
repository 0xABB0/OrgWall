# Hand-authored. slang-runtime = the slang release prebuilt, one repo per
# platform. No android/ios/wasm prebuilt is published in this release, so those
# platforms fall to the empty default. The slang lib wraps it.
cc_library(
    name = "slang-runtime",
    visibility = ["//visibility:public"],
    deps = select({
        "//bazel/config:plat_macos": ["@slang_macos//:slang_runtime"],
        "//bazel/config:plat_linux": ["@slang_linux//:slang_runtime"],
        "//bazel/config:plat_win32": ["@slang_win32//:slang_runtime"],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "slang",
    srcs = glob(["src/*.cpp"]),
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
    linkopts = select({
        "//bazel/config:plat_macos": ["-lc++"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [":slang-runtime"],
)

cc_test(
    name = "slang-compile",
    srcs = ["test/compile_test.c"] + glob(["**/*.h"], allow_empty = True),
    deps = [
        ":slang",
        "//modules/test:test",
        "//modules/core:core",
        "//tools/test:runner",
    ],
)
