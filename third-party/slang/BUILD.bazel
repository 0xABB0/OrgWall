# Hand-authored. slang-runtime = the slang release prebuilt (@slang_macos on the
# host); wasm/android/ios prebuilts are Phase 4. The slang lib wraps it.
cc_library(
    name = "slang-runtime",
    visibility = ["//visibility:public"],
    deps = select({
        "//bazel/config:plat_macos": ["@slang_macos//:slang_runtime"],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "slang",
    srcs = glob(["src/*.cpp"]),
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
    linkopts = select({
        "//bazel/config:plat_macos": ["-lc++"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [":slang-runtime"],
)

cc_test(
    name = "slang-compile",
    srcs = ["test/compile_test.c"] + glob(["**/*.h"], allow_empty = True),
    deps = [
        ":slang",
        "//modules/test:test",
        "//modules/core:core",
        "//tools/test:runner",
    ],
)
