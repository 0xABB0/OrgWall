package(default_visibility = ["//visibility:public"])

platform(
    name = "macos",
    constraint_values = [
        "@platforms//os:osx",
        "@platforms//cpu:arm64",
    ],
)

platform(
    name = "ios",
    constraint_values = [
        "@platforms//os:ios",
        "@platforms//cpu:arm64",
    ],
)

platform(
    name = "linux",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "android",
    constraint_values = [
        "@platforms//os:android",
        "@platforms//cpu:arm64",
    ],
)

# rules_android names each apk native-lib dir (lib/<abi>/) after the
# --android_platforms platform's own name, so the ABI split platform is named
# for the ABI itself: lib/arm64-v8a/libmelody.so, not lib/android/.
platform(
    name = "arm64-v8a",
    constraint_values = [
        "@platforms//os:android",
        "@platforms//cpu:arm64",
    ],
)

platform(
    name = "win32",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "wasm",
    constraint_values = [
        "@platforms//cpu:wasm32",
    ],
)

# Execution platform for the native Windows build (--config=win32native). Bazel's
# autodetected clang-cl toolchain (@local_config_cc//:cc-toolchain-x64_windows-clang-cl)
# gates its exec_compatible_with on the @rules_cc clang-cl constraint, so the host
# must declare it to be selected over the default msvc/cl.exe toolchain. This is the
# running host (x86_64 Windows) plus that marker.
platform(
    name = "win32_clang_cl_host",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
        "@rules_cc//cc/private/toolchain:clang-cl",
    ],
)
