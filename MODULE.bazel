module(
    name = "melody",
    version = "0.0.0",
)

# apple_support MUST precede rules_cc: toolchain selection is registration-order
# sensitive, so rules_cc first shadows the Apple CC toolchain and breaks
# objc_library compilation.
bazel_dep(name = "apple_support", version = "2.6.1")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.19")
bazel_dep(name = "rules_apple", version = "4.5.3")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")
bazel_dep(name = "hermetic_cc_toolchain", version = "4.1.0")
bazel_dep(name = "rules_android_ndk", version = "0.1.5")
bazel_dep(name = "toolchains_llvm", version = "1.8.0")
bazel_dep(name = "stdexec", version = "0.0.0-20260427-35670665")

# toolchains_llvm here is ONLY a per-exec-host provider of clang-cl/lld-link/
# llvm-lib for the hermetic win32 (MSVC ABI) cross-toolchain — its own CC
# toolchains are NOT registered (macOS=apple_support, linux=zig).
llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(name = "llvm_toolchain", llvm_version = "22.1.6")
use_repo(llvm, "llvm_toolchain_llvm")

# Hermetic MSVC-ABI win32 toolchain: clang-cl/lld-link (from llvm above) + a
# Windows SDK/CRT sysroot from xwin. @xwin is fetched lazily — only a win32 build
# triggers the splat.
xwin_repo = use_repo_rule("//bazel/toolchain/windows:xwin.bzl", "xwin_sysroot")

xwin_repo(name = "xwin")

register_toolchains("//bazel/toolchain/windows:clang_cl_toolchain")

android_ndk = use_extension("@rules_android_ndk//:extension.bzl", "android_ndk_repository_extension")
# NDK located via $ANDROID_NDK_HOME — no hardcoded host path. No maintained
# ruleset auto-downloads the NDK; only its location is discovered, so the env
# var must be set locally and in CI.
android_ndk.configure(api_level = 26)
use_repo(android_ndk, "androidndk")

# Android toolchains are registered per-config (.bazelrc build:android) rather than
# globally: the `:all` wildcard force-fetches @androidndk — and demands
# $ANDROID_NDK_HOME — on every build, including macOS where the NDK is irrelevant.

# rules_android supplies the .apk pipeline (aapt2/d8/manifest-merge/zipalign/sign);
# the NDK above provides the native .so. The SDK toolchain is likewise registered
# per-config (.bazelrc build:android), not here, so @androidsdk — which demands
# $ANDROID_HOME — is never force-fetched on a macОS build. @android_tools fetches
# lazily, only when an android_binary is actually built.
bazel_dep(name = "rules_android", version = "0.7.3")

remote_android_extensions = use_extension("@rules_android//bzlmod_extensions:android_extensions.bzl", "remote_android_tools_extensions")
use_repo(remote_android_extensions, "android_tools")

android_sdk_repository_extension = use_extension("@rules_android//rules/android_sdk_repository:rule.bzl", "android_sdk_repository_extension")
use_repo(android_sdk_repository_extension, "androidsdk")

bazel_dep(name = "emsdk", version = "4.0.17")

register_toolchains(
    "@emsdk//emscripten_toolchain:cc-toolchain-wasm-emscripten_mac_arm64",
    "@emsdk//emscripten_toolchain:cc-toolchain-wasm-emscripten_mac",
    "@emsdk//emscripten_toolchain:cc-toolchain-wasm-emscripten_linux",
    "@emsdk//emscripten_toolchain:cc-toolchain-wasm-emscripten_linux_arm64",
)

# zig-based cross toolchains (linux now; win32-gnu later). macOS host stays on
# apple_support; only linux toolchains are registered so host resolution is unchanged.
zig = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(zig, "zig_sdk")

# Linux only: zig is MinGW-ABI on Windows, so win32 builds use the clang-cl/xwin
# toolchain (MSVC ABI) registered above, not zig.
register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_gnu.2.28",
    "@zig_sdk//toolchain:linux_arm64_gnu.2.28",
)

single_version_override(
    module_name = "hermetic_cc_toolchain",
    patch_strip = 1,
    patches = [
        "//bazel/patches:zig_0_14_sdk.patch",
        "//bazel/patches:zig_0_14_defs.patch",
        "//bazel/patches:zig_0_14_wrapper.patch",
    ],
)

llvm_ext = use_extension("//bazel/extensions:llvm.bzl", "llvm_ext")
use_repo(llvm_ext, "llvm")

# slang shader compiler — GitHub release prebuilts, one repo per platform; the
# select in //third-party/slang maps the resolved platform to its repo. No
# android prebuilt is published in this release (linux/macos/windows + wasm only),
# so android is not wired.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "slang_macos",
    build_file = "//bazel/third_party:slang.BUILD",
    sha256 = "5f37e80b16ee332669fa2355485f6cf2795fa5d406bf6e0b1533b3ea2f0e6d76",
    url = "https://github.com/shader-slang/slang/releases/download/v2026.10.2/slang-2026.10.2-macos-aarch64.zip",
)

http_archive(
    name = "slang_linux",
    build_file = "//bazel/third_party:slang_linux.BUILD",
    sha256 = "ff3db135c2e896da9241a092c3fcf489bfa9f3809467559f07abf3840c9d3f31",
    url = "https://github.com/shader-slang/slang/releases/download/v2026.10.2/slang-2026.10.2-linux-x86_64.zip",
)

http_archive(
    name = "slang_win32",
    build_file = "//bazel/third_party:slang_win32.BUILD",
    sha256 = "f21fca4ba78bfb366ef3b282b4926e3efca61c2ffd72a482b024c9f8413331d0",
    url = "https://github.com/shader-slang/slang/releases/download/v2026.10.2/slang-2026.10.2-windows-x86_64.zip",
)

# macOS Vulkan loader (MoltenVK): location discovered from $VULKAN_SDK or
# `brew --prefix`, never hardcoded. Fetched lazily — only a macOS Vulkan build
# references @vulkan_macos//:loader, so non-macOS/non-Vulkan builds never run brew.
vulkan_repo = use_repo_rule("//bazel/extensions:vulkan.bzl", "vulkan_sysroot")

vulkan_repo(name = "vulkan_macos")

# compile_commands.json for clangd (replaces nob's compdb).
http_archive(
    name = "hedron_compile_commands",
    sha256 = "1b08abffbfbe89f6dbee6a5b33753792e8004f6a36f37c0f72115bec86e68724",
    strip_prefix = "bazel-compile-commands-extractor-abb61a688167623088f8768cc9264798df6a9d10",
    url = "https://github.com/hedronvision/bazel-compile-commands-extractor/archive/abb61a688167623088f8768cc9264798df6a9d10.tar.gz",
    patch_args = ["-p1"],
    patches = ["//bazel/patches:hedron_apple_sdkroot.patch"],
)
