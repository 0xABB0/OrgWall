package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "repl-cli",
    srcs = glob(["src/*.c"]),
    target_compatible_with = select({
        "//bazel/config:plat_wasm": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        "//modules/repl",
        "//modules/clang",
        "//modules/llvm",
        "//modules/jit",
        "//modules/boot",
        "//modules/vat",
        "//modules/port",
        "//modules/executor",
        "//modules/future",
        "//modules/core",
        "//modules/allocator",
        "//modules/string",
        "//modules/collection",
        "//modules/log",
    ],
)
