#version 460
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 4, binding = 0, rgba8) uniform writeonly image2D u_images[];

layout(push_constant, std430) uniform Root
{
    uint  image;
    uint  w;
    uint  h;
    float pad;
} root;

float hash(vec2 p)
{
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

void main()
{
    uvec2 px = gl_GlobalInvocationID.xy;
    if (px.x >= root.w || px.y >= root.h)
        return;

    vec2 uv = vec2(px) / vec2(root.w, root.h);
    float seed = hash(uv);
    float a = 1.0;
    float b = 0.0;
    float cx = (uv.x - 0.5) * float(root.w) / 64.0;
    float cy = (uv.y - 0.5) * float(root.h) / 64.0;
    float inside = float(cx * cx + cy * cy < 1.5 || seed > 0.93);
    b = inside;
    a = 1.0 - inside;
    imageStore(u_images[nonuniformEXT(root.image)], ivec2(px), vec4(a, b, 0.0, 1.0));
}
