#version 460
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform texture2D u_textures[];
layout(set = 1, binding = 0) uniform sampler   u_samplers[];
layout(set = 4, binding = 0, rgba8) uniform writeonly image2D u_images[];

layout(push_constant, std430) uniform Root
{
    uint  src_tex;
    uint  src_smp;
    uint  dst_img;
    uint  w;
    uint  h;
    float da;
    float db;
    float feed;
    float kill;
    float dt;
    float pad0;
    float pad1;
} root;

vec2 sample_ab(vec2 uv)
{
    return texture(sampler2D(u_textures[nonuniformEXT(root.src_tex)], u_samplers[nonuniformEXT(root.src_smp)]), uv).xy;
}

vec2 laplacian(vec2 uv, float px, float py)
{
    vec2 c  = sample_ab(uv);
    vec2 l  = sample_ab(uv + vec2(-px,  0.0));
    vec2 r  = sample_ab(uv + vec2( px,  0.0));
    vec2 u  = sample_ab(uv + vec2( 0.0,-py));
    vec2 d  = sample_ab(uv + vec2( 0.0, py));
    vec2 ul = sample_ab(uv + vec2(-px, -py));
    vec2 ur = sample_ab(uv + vec2( px, -py));
    vec2 dl = sample_ab(uv + vec2(-px,  py));
    vec2 dr = sample_ab(uv + vec2( px,  py));
    return -c + 0.2 * (l + r + u + d) + 0.05 * (ul + ur + dl + dr);
}

void main()
{
    uvec2 gid = gl_GlobalInvocationID.xy;
    if (gid.x >= root.w || gid.y >= root.h)
        return;

    float pw = 1.0 / float(root.w);
    float ph = 1.0 / float(root.h);
    vec2  uv = (vec2(gid) + 0.5) * vec2(pw, ph);

    vec2  c = sample_ab(uv);
    float a = c.x;
    float b = c.y;

    vec2  lap      = laplacian(uv, pw, ph);
    float reaction = a * b * b;
    float na = clamp(a + (root.da * lap.x - reaction + root.feed * (1.0 - a)) * root.dt, 0.0, 1.0);
    float nb = clamp(b + (root.db * lap.y + reaction - (root.kill + root.feed) * b) * root.dt, 0.0, 1.0);
    imageStore(u_images[nonuniformEXT(root.dst_img)], ivec2(gid), vec4(na, nb, 0.0, 1.0));
}
