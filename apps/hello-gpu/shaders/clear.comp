#version 460
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 4, binding = 0, rgba8) uniform writeonly image2D u_images[];

layout(push_constant, std430) uniform Root
{
    uint  image;
    uint  w;
    uint  h;
    float time;
} root;

void main()
{
    uvec2 px = gl_GlobalInvocationID.xy;
    if (px.x >= root.w || px.y >= root.h)
        return;
    vec2  uv = (vec2(px) + 0.5) / vec2(root.w, root.h);
    float r = distance(uv, vec2(0.5));
    vec3  base = mix(vec3(0.05, 0.06, 0.10), vec3(0.01, 0.02, 0.04), r * 1.4);
    base += 0.015 * sin(uv.x * 40.0 + root.time) * sin(uv.y * 40.0 - root.time);
    imageStore(u_images[nonuniformEXT(root.image)], ivec2(px), vec4(base, 1.0));
}
