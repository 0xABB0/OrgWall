#version 460
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform texture2D u_textures[];
layout(set = 1, binding = 0) uniform sampler   u_samplers[];
layout(set = 4, binding = 0, rgba8) uniform writeonly image2D u_images[];

layout(push_constant, std430) uniform Root
{
    uint src_tex;
    uint src_smp;
    uint dst_img;
    uint w;
    uint h;
    float pad0;
    float pad1;
    float pad2;
} root;

void main()
{
    uvec2 px = gl_GlobalInvocationID.xy;
    if (px.x >= root.w || px.y >= root.h)
        return;

    float w = float(root.w);
    float h = float(root.h);
    float dy = 1.0 / h;
    float cx = (float(px.x) + 0.5) / w;

    const float weights[7] = float[7](0.0625, 0.125, 0.1875, 0.25, 0.1875, 0.125, 0.0625);
    vec3 acc = vec3(0.0);
    for (int i = -3; i <= 3; ++i)
    {
        float cy = (float(px.y) + 0.5 + float(i)) / h;
        acc += texture(sampler2D(u_textures[nonuniformEXT(root.src_tex)], u_samplers[nonuniformEXT(root.src_smp)]), vec2(cx, cy)).rgb * weights[i + 3];
    }
    imageStore(u_images[nonuniformEXT(root.dst_img)], ivec2(px), vec4(acc, 1.0));
}
