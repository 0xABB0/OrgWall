#version 460
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 4, binding = 0, rgba8) uniform writeonly image2D u_images[];

layout(push_constant, std430) uniform Root
{
    uint  image;
    uint  w;
    uint  h;
    uint  max_iter;
    float center_x;
    float center_y;
    float scale;
    float time;
} root;

vec3 palette(float t)
{
    vec3 a = vec3(0.5, 0.5, 0.5);
    vec3 b = vec3(0.5, 0.5, 0.5);
    vec3 c = vec3(1.0, 1.0, 1.0);
    vec3 d = vec3(0.0, 0.10, 0.20);
    return a + b * cos(6.2831853 * (c * t + d));
}

void main()
{
    uvec2 px = gl_GlobalInvocationID.xy;
    if (px.x >= root.w || px.y >= root.h)
        return;

    float aspect = float(root.w) / float(root.h);
    float cx = (float(px.x) + 0.5) / float(root.w) - 0.5;
    float cy = (float(px.y) + 0.5) / float(root.h) - 0.5;
    cx *= aspect;

    float re = root.center_x + cx * root.scale;
    float im = root.center_y + cy * root.scale;

    float zr = 0.0;
    float zi = 0.0;
    uint  i = 0;
    float mag2 = 0.0;
    for (; i < root.max_iter; ++i)
    {
        float zr2 = zr * zr;
        float zi2 = zi * zi;
        mag2 = zr2 + zi2;
        if (mag2 > 65536.0)
            break;
        zi = 2.0 * zr * zi + im;
        zr = zr2 - zi2 + re;
    }

    vec3 col;
    if (i >= root.max_iter)
    {
        col = vec3(0.0);
    }
    else
    {
        float fi = float(i);
        float smooth_i = fi + 1.0 - log2(log(mag2) * 0.5);
        float t = smooth_i / float(root.max_iter);
        t = pow(clamp(t, 0.0, 1.0), 0.5);
        col = palette(t * 2.5 + root.time * 0.04);
        col *= 0.35 + 0.65 * clamp(smooth_i * 0.04, 0.0, 1.0);
    }

    imageStore(u_images[nonuniformEXT(root.image)], ivec2(px), vec4(col, 1.0));
}
