#version 460
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 64) in;

struct Particle
{
    vec4 pos_life;
    vec4 vel;
};

layout(set = 0, binding = 2, std430) buffer Particles { Particle p[]; } buf[];

layout(push_constant, std430) uniform Root
{
    uint  particles;
    uint  total;
    float dt;
    float time;
    float attract_x;
    float attract_y;
} root;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= root.total)
        return;

    Particle pt = buf[nonuniformEXT(root.particles)].p[i];
    vec2 attract = vec2(root.attract_x, root.attract_y);

    vec2  to = attract - pt.pos_life.xy;
    float d2 = max(dot(to, to), 0.01);
    vec2  accel = to / d2 * 0.10;

    pt.vel.xy = pt.vel.xy * 0.992 + accel * root.dt;
    pt.pos_life.xy += pt.vel.xy * root.dt;
    pt.pos_life.z -= root.dt * 0.25;

    if (pt.pos_life.z <= 0.0 || abs(pt.pos_life.x) > 1.3 || abs(pt.pos_life.y) > 1.3)
    {
        float a = pt.pos_life.w + root.time * 1.7 + float(i) * 0.013;
        float r = 0.9 + 0.1 * fract(sin(float(i) * 12.9898) * 43758.5453);
        pt.pos_life.xy = r * vec2(cos(a), sin(a));
        pt.vel.xy = 0.15 * vec2(-sin(a), cos(a));
        pt.pos_life.z = 1.0;
    }

    buf[nonuniformEXT(root.particles)].p[i] = pt;
}
