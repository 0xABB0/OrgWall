#version 460
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 4, binding = 0, rgba8) uniform writeonly image2D u_images[];

layout(push_constant, std430) uniform Root
{
    uint  image;
    uint  w;
    uint  h;
    float time;
} root;

vec3 sphere_hit(vec3 ro, vec3 rd, vec3 center, float radius, vec3 col)
{
    vec3  oc = ro - center;
    float b = dot(oc, rd);
    float c = dot(oc, oc) - radius * radius;
    float h = b * b - c;
    if (h < 0.0)
        return vec3(0.0);
    float t = -b - sqrt(h);
    if (t < 0.0)
        return vec3(0.0);
    vec3  p = ro + t * rd;
    vec3  n = normalize(p - center);
    vec3  ld = normalize(vec3(2.0, 3.0, 1.0));
    float diff = max(dot(n, ld), 0.0);
    float spec = pow(max(dot(reflect(-ld, n), -rd), 0.0), 32.0);
    return col * (0.1 + 0.9 * diff) + vec3(spec * 0.6);
}

void main()
{
    uvec2 px = gl_GlobalInvocationID.xy;
    if (px.x >= root.w || px.y >= root.h)
        return;

    float aspect = float(root.w) / float(root.h);
    vec2  uv = (vec2(px) + 0.5) / vec2(root.w, root.h) * 2.0 - 1.0;
    uv.x *= aspect;

    vec3 ro = vec3(0.0, 0.0, -4.0);
    vec3 rd = normalize(vec3(uv, 1.8));
    float t = root.time;

    vec3 col = vec3(0.0);

    col += sphere_hit(ro, rd, vec3(1.6 * cos(t * 0.7),           0.9 * sin(t * 0.5),          0.0),                  0.55, vec3(2.8, 0.4, 0.2));
    col += sphere_hit(ro, rd, vec3(1.6 * cos(t * 0.7 + 2.094),   0.9 * sin(t * 0.5 + 2.094),  0.5 * sin(t * 0.3)),   0.55, vec3(0.3, 2.4, 0.4));
    col += sphere_hit(ro, rd, vec3(1.6 * cos(t * 0.7 + 4.189),   0.9 * sin(t * 0.5 + 4.189),  0.5 * sin(t * 0.3 + 1.0)), 0.55, vec3(0.3, 0.4, 3.0));
    col += sphere_hit(ro, rd, vec3(0.0,                           0.0,                         1.2 * sin(t * 0.4)),   0.55, vec3(2.4, 1.8, 0.2));

    imageStore(u_images[nonuniformEXT(root.image)], ivec2(px), vec4(col, 1.0));
}
