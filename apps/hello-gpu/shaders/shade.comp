#version 460
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 64) in;

struct Agent
{
    vec4 pos_phase;
};

layout(set = 2, binding = 0, std430) readonly buffer Agents { Agent a[]; } agents_buf[];
layout(set = 2, binding = 0, std430) readonly buffer Survivors { uint count; uint pad0; uint pad1; uint pad2; uint idx[]; } surv_buf[];
layout(set = 4, binding = 0, rgba8) uniform image2D u_images[];

layout(push_constant, std430) uniform Root
{
    uint  agents;
    uint  survivors;
    uint  image;
    uint  total;
    uint  w;
    uint  h;
    float time;
    float pad;
} root;

void main()
{
    uint s = gl_GlobalInvocationID.x;
    if (s >= surv_buf[nonuniformEXT(root.survivors)].count)
        return;

    uint  i = surv_buf[nonuniformEXT(root.survivors)].idx[s];
    Agent ag = agents_buf[nonuniformEXT(root.agents)].a[i];
    float ang = ag.pos_phase.w + root.time * 0.6;
    vec2  p = ag.pos_phase.xy + ag.pos_phase.z * vec2(cos(ang), sin(ang));

    vec2 centre = (p * 0.5 + 0.5) * vec2(root.w, root.h);
    float hue = float(i) / float(root.total);
    vec3  col = 0.5 + 0.5 * cos(6.2831 * (hue + vec3(0.0, 0.33, 0.67)));

    int   rad = 7;
    ivec2 c = ivec2(centre);
    for (int dy = -rad; dy <= rad; ++dy)
        for (int dx = -rad; dx <= rad; ++dx)
        {
            ivec2 px = c + ivec2(dx, dy);
            if (px.x < 0 || px.y < 0 || px.x >= int(root.w) || px.y >= int(root.h))
                continue;
            float d = length(vec2(dx, dy)) / float(rad);
            if (d > 1.0)
                continue;
            float fall = 1.0 - d;
            vec4  prev = imageLoad(u_images[nonuniformEXT(root.image)], px);
            imageStore(u_images[nonuniformEXT(root.image)], px, vec4(prev.rgb + col * fall * fall * 0.9, 1.0));
        }
}
