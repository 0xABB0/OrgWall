#version 460
#extension GL_EXT_nonuniform_qualifier : require

// Animated plasma evaluated on the GPU: one invocation per grid cell writes an
// RGBA colour into a heap-resident storage buffer. The graphics pass then reads
// that same buffer per-instance to tint a grid of quads, so compute, a buffer
// barrier, and a draw all live in one frame command list (gpu-rhi.md §6.5/§6.7).
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 2, std430) writeonly buffer Cells
{
    vec4 color[];
} u_buffers[];

layout(push_constant, std430) uniform Root
{
    uint  cell_buf;
    uint  grid_w;
    uint  grid_h;
    float time;
} root;

void main()
{
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= root.grid_w || y >= root.grid_h)
        return;

    float fx = float(x) / float(root.grid_w);
    float fy = float(y) / float(root.grid_h);
    float t = root.time;

    float v = sin(fx * 10.0 + t)
            + sin((fy * 10.0 + t) * 0.8)
            + sin((fx + fy) * 8.0 + t * 1.3)
            + sin(sqrt((fx - 0.5) * (fx - 0.5) + (fy - 0.5) * (fy - 0.5)) * 24.0 - t * 2.0);
    v *= 0.25;

    vec3 col = 0.5 + 0.5 * vec3(
        sin(v * 3.14159 + 0.0),
        sin(v * 3.14159 + 2.094),
        sin(v * 3.14159 + 4.188));

    uint idx = y * root.grid_w + x;
    u_buffers[nonuniformEXT(root.cell_buf)].color[idx] = vec4(col, 1.0);
}
