#version 460
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 64) in;

struct Agent
{
    vec4 pos_phase;
};

layout(set = 2, binding = 0, std430) readonly buffer Agents { Agent a[]; } agents_buf[];
layout(set = 2, binding = 0, std430) buffer Survivors { uint count; uint pad0; uint pad1; uint pad2; uint idx[]; } surv_buf[];

layout(push_constant, std430) uniform Root
{
    uint  agents;
    uint  survivors;
    uint  total;
    uint  pad;
    float time;
    float cull_r;
    float cull_x;
    float cull_y;
} root;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= root.total)
        return;

    Agent ag = agents_buf[nonuniformEXT(root.agents)].a[i];
    float ang = ag.pos_phase.w + root.time * 0.6;
    vec2  p = ag.pos_phase.xy + ag.pos_phase.z * vec2(cos(ang), sin(ang));

    if (distance(p, vec2(root.cull_x, root.cull_y)) <= root.cull_r)
    {
        uint slot = atomicAdd(surv_buf[nonuniformEXT(root.survivors)].count, 1u);
        surv_buf[nonuniformEXT(root.survivors)].idx[slot] = i;
    }
}
