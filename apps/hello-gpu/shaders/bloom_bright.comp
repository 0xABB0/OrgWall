#version 460
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform texture2D u_textures[];
layout(set = 0, binding = 1) uniform sampler   u_samplers[];
layout(set = 0, binding = 4, rgba8) uniform writeonly image2D u_images[];

layout(push_constant, std430) uniform Root
{
    uint  src_tex;
    uint  src_smp;
    uint  dst_img;
    uint  w;
    uint  h;
    float threshold;
    float pad0;
    float pad1;
} root;

void main()
{
    uvec2 px = gl_GlobalInvocationID.xy;
    if (px.x >= root.w || px.y >= root.h)
        return;

    vec2 uv = (vec2(px) + 0.5) / vec2(root.w, root.h);
    vec3 col = texture(sampler2D(u_textures[nonuniformEXT(root.src_tex)], u_samplers[nonuniformEXT(root.src_smp)]), uv).rgb;
    float lum = dot(col, vec3(0.2126, 0.7152, 0.0722));
    vec3  bright = (lum > root.threshold) ? col * (lum - root.threshold) / max(lum, 0.001) : vec3(0.0);
    imageStore(u_images[nonuniformEXT(root.dst_img)], ivec2(px), vec4(bright, 1.0));
}
